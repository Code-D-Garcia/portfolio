---
import { toLang, useTranslations } from '../../../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section id="education" class="education-section">
	<h2 class="section-title">{t('education.title')}</h2>
	<p class="section-kicker">{t('education.kicker')}</p>

	<article class="education-card panel">
		<span class="education-icon" aria-hidden="true">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
		</span>
		<div class="education-body">
			<h3 class="education-degree">{t('education.uni.degree')}</h3>
			<p class="education-meta">
				<span class="education-school">{t('education.uni.name')}</span>
				<span class="education-date">{t('education.uni.date')}</span>
			</p>
		</div>
	</article>
</section>

<style>
	.education-card {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}

	.education-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--border-light);
		border-radius: var(--radius);
		background-color: var(--accent-soft);
		color: var(--accent);
	}

	.education-body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
	}

	.education-degree {
		font-size: 1rem;
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.education-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin: 0;
	}

	.education-school {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--accent);
	}

	.education-date {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gold);
	}
</style>

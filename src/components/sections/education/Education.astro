---
import { toLang, useTranslations } from '../../../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section id="education" class="education-section">
	<h2 class="section-title">{t('education.title')}</h2>
	<p class="section-kicker">{t('education.kicker')}</p>
	
	<div class="education-timeline">
		<article class="education-item">
			<div class="timeline-dot"></div>
			<div class="education-content panel">
				<div class="education-header">
					<h3 class="education-role">{t('education.uni.degree')}</h3>
					<span class="education-date">{t('education.uni.date')}</span>
				</div>
				<h4 class="education-company">{t('education.uni.name')}</h4>
			</div>
		</article>
	</div>
</section>

<style>
	.education-timeline {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		position: relative;
		padding-left: 1.75rem;
	}

	/* The path between waypoints */
	.education-timeline::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0.4rem;
		width: 0;
		border-left: 2px dashed var(--border-dark);
	}

	.education-item {
		position: relative;
	}

	/* Waypoint marker */
	.timeline-dot {
		position: absolute;
		left: -1.75rem;
		top: 1.35rem;
		width: 0.9rem;
		height: 0.9rem;
		background-color: var(--bg-primary);
		border: 2px solid var(--accent);
		transform: rotate(45deg);
		z-index: 1;
	}

	.education-item:first-child .timeline-dot {
		background-color: var(--accent);
	}

	.education-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 1.5rem;
	}

	.education-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	@media (min-width: 560px) {
		.education-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
			gap: 1rem;
		}
	}

	.education-role {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.education-date {
		flex-shrink: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.education-company {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--accent);
	}
</style>

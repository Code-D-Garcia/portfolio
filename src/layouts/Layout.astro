---
import { ClientRouter } from 'astro:transitions';
import { defaultLang, languages, toLang, useTranslations, type Lang } from '../i18n/ui';
import Footer from '../components/layout/footer/Footer.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/cinzel';
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname.replace(`/${lang}`, '');
const pageTitle = title || t('site.title');
const description = t('site.description');

// Absolute URLs need `site` in astro.config.mjs; without it they stay relative.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const localePath = (code: Lang) => absolute(`/${code}${currentPath}`);
const canonical = localePath(lang);
const ogImage = absolute(`/og/${lang}.jpg`);
const ogLocale: Record<Lang, string> = { es: 'es_EC', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		
		<script is:inline>
			const applyTheme = () => {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return 'dark';
					}
					return 'light';
				})();
				
				if (theme === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
				window.localStorage.setItem('theme', theme);
			};

			applyTheme();
			document.addEventListener('astro:after-swap', () => {
				applyTheme();
				
				const scrollPos = sessionStorage.getItem('scrollPosition');
				if (scrollPos !== null) {
					const html = document.documentElement;
					html.style.scrollBehavior = 'auto';
					
					window.scrollTo(0, parseInt(scrollPos));
					
					requestAnimationFrame(() => {
						html.style.scrollBehavior = '';
					});
					
					sessionStorage.removeItem('scrollPosition');
				}
			});
		</script>
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		{(Object.keys(languages) as Lang[]).map((code) => (
			<link rel="alternate" hreflang={code} href={localePath(code)} />
		))}
		<link rel="alternate" hreflang="x-default" href={localePath(defaultLang)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="David Garcia" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t('site.title')} />
		<meta property="og:locale" content={ogLocale[lang]} />
		{(Object.keys(languages) as Lang[]).filter((code) => code !== lang).map((code) => (
			<meta property="og:locale:alternate" content={ogLocale[code]} />
		))}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

	</head>
	<body>
		<a href="#main" class="skip-link">{t('a11y.skip')}</a>
		<slot />
		<Footer />
	</body>
</html>



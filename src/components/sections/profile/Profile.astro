---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { toLang, useTranslations } from '../../../i18n/ui';
import { cvUrl, socialLinks } from '../../../data/social';
import { experienceYears } from '../../../utils/experience';
import profilePhoto from '../../../assets/photo.webp';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const jobs = await getCollection('experience');
const years = experienceYears(jobs);

// `{years}` in the bio is filled from the experience entries.
const bio = t('profile.bio').replace('{years}', String(years));
const email = socialLinks.find((social) => social.url.startsWith('mailto:'))?.url;

// "+N" in Spanish, "N+" in English.
const atLeast = (n: number) => (lang === 'es' ? `+${n}` : `${n}+`);

const stats = [
	{ value: atLeast(years), label: t('profile.stat.years') },
	{ value: atLeast(6), label: t('profile.stat.projects') },
];
---
<section id="profile" class="profile-section">
	<div class="profile-wrapper">
		<div class="profile-info">
			<div class="header">
				<p class="role">{t('profile.role')}</p>
				<h1 class="name">David Garcia</h1>
			</div>

			<dl class="stats">
				{stats.map((stat) => (
					<div class="stat">
						<dt class="stat-label">{stat.label}</dt>
						<dd class="stat-value">{stat.value}</dd>
					</div>
				))}
			</dl>

			<div class="actions">
				<a href={cvUrl} class="btn btn-primary" download="David-Garcia-CV.pdf" type="application/pdf">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					{t('cv.download')}
				</a>
				{email && (
					<a href={email} class="btn btn-secondary">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
						{t('profile.contact')}
					</a>
				)}
				<div class="social-links">
					{socialLinks.filter((social) => !social.url.startsWith('mailto:')).map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.name}
							title={social.name}
							class="social-icon"
							set:html={social.icon}
						/>
					))}
				</div>
			</div>
		</div>

		<div class="profile-image-container">
			<Image src={profilePhoto} alt="David Garcia" class="profile-image" loading="eager" />
		</div>
	</div>

	<p class="bio">{bio}</p>
</section>

<style>
	.profile-section {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.profile-wrapper {
		display: flex;
		flex-direction: column-reverse;
		gap: 2rem;
	}

	.profile-info {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.header {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.role {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.role::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border: 2px solid var(--gold);
		transform: rotate(45deg);
	}

	.name {
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--text-primary);
		line-height: 1.1;
	}


	/* Stats: two framed counters, label above value for screen readers (dt/dd). */
	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
		margin: 0;
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.15rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--border-light);
		border-left: 3px solid var(--accent);
		border-radius: var(--radius);
		background-color: var(--bg-secondary);
	}

	.stat-value {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--accent);
	}

	.stat-label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-secondary);
		line-height: 1.3;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-secondary);
		padding: 0.5rem;
		border-radius: var(--radius);
		transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
	}

	.social-icon:hover {
		color: var(--accent);
		background-color: var(--accent-soft);
		transform: translateY(-1px);
	}

	.profile-image-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.profile-image {
		width: 150px;
		height: 150px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--accent);
		outline: 1px solid var(--border-dark);
		outline-offset: 6px;
		box-shadow: var(--shadow);
		transition: transform 0.3s ease;
	}

	.profile-image:hover {
		transform: scale(1.03);
	}

	.bio {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.8;
		padding-left: 1.25rem;
		border-left: 1px dashed var(--border-dark);
	}

	@media (min-width: 768px) {
		.profile-wrapper {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			gap: 3rem;
		}

		.profile-info {
			flex: 1;
		}

		.profile-image-container {
			flex-shrink: 0;
		}

		.profile-image {
			width: 220px;
			height: 220px;
		}

		.name {
			font-size: 3.4rem;
		}


		.stat-value {
			font-size: 1.9rem;
		}

		.bio {
			font-size: 1.05rem;
		}
	}
</style>

---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import ImageModal from '../../ui/image-modal/ImageModal.astro';
import { projectFilters } from '../../../data/project-filters';
import { toLang, useTranslations } from '../../../i18n/ui';

interface Props {
	limit?: number;
	showAllLink?: boolean;
	showFilters?: boolean;
}

const { limit, showAllLink = false, showFilters = false } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = limit ? allProjects.slice(0, limit) : allProjects;

const usedTech = new Set(allProjects.flatMap((p) => p.data.stack));
const filters = projectFilters.filter((tech) => usedTech.has(tech));
---

<section id="projects" class="projects-section">
	<h2 class="section-title">
		{showFilters ? t('projects.all.title') : t('projects.title')}
	</h2>
	<p class="section-kicker">{t('projects.kicker')}</p>

	{showFilters && <ProjectFilters filters={filters} />}

	<div class="projects-grid">
		{projects.map((project) => <ProjectCard project={project.data} />)}
	</div>

	{showAllLink && (
		<div class="show-all-wrapper">
			<a href={getRelativeLocaleUrl(lang, 'other/projects/')} class="btn btn-secondary">
				{t('projects.more')}
			</a>
		</div>
	)}
</section>

<ImageModal />

<style>
	.projects-section {
		display: flex;
		flex-direction: column;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.projects-grid {
			grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		}
	}

	.show-all-wrapper {
		display: flex;
		justify-content: center;
		margin-top: 3rem;
	}



</style>

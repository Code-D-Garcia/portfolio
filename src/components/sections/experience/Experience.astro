---
import { getCollection } from 'astro:content';
import { formatYearMonth, toLang, useTranslations } from '../../../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// Most recent first.
const jobs = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));
---
<section id="experience" class="experience-section">
	<h2 class="section-title">{t('experience.title')}</h2>
	<p class="section-kicker">{t('experience.kicker')}</p>

	<div class="experience-timeline">
		{jobs.map(({ data: job }) => (
			<article class="experience-item">
				<div class="timeline-dot"></div>
				<div class="experience-content panel">
					<div class="experience-header">
						<h3 class="experience-role">{job.role[lang]}</h3>
						<span class="experience-date">
							{formatYearMonth(job.start, lang)} - {job.end ? formatYearMonth(job.end, lang) : t('experience.present')}
						</span>
					</div>
					<h4 class="experience-company">{job.company}</h4>
					<p class="experience-description">{job.description[lang]}</p>

					{job.stack.length > 0 && (
						<div class="experience-stack">
							{job.stack.map((tech) => (
								<span class="stack-tag">{tech}</span>
							))}
						</div>
					)}
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.experience-timeline {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		position: relative;
		padding-left: 1.75rem;
	}

	/* The path between waypoints */
	.experience-timeline::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0.4rem;
		width: 0;
		border-left: 2px dashed var(--border-dark);
	}

	.experience-item {
		position: relative;
	}

	/* Waypoint marker */
	.timeline-dot {
		position: absolute;
		left: -1.75rem;
		top: 1.35rem;
		width: 0.9rem;
		height: 0.9rem;
		background-color: var(--bg-primary);
		border: 2px solid var(--accent);
		transform: rotate(45deg);
		z-index: 1;
	}

	.experience-item:first-child .timeline-dot {
		background-color: var(--accent);
	}

	.experience-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 1.5rem;
	}

	.experience-header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	@media (min-width: 560px) {
		.experience-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
			gap: 1rem;
		}
	}

	.experience-role {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.4;
	}

	.experience-date {
		flex-shrink: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.experience-company {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--accent);
	}

	.experience-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.experience-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.5rem;
	}
</style>

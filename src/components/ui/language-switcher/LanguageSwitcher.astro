---
import { languages, toLang, useTranslations } from '../../../i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(`/${lang}`, '');
---

<nav class="lang-switcher" aria-label={t('a11y.language')}>
  {
    Object.entries(languages).map(([code, label]) => (
      <a
        href={`/${code}${currentPath}`}
        class={`lang-btn ${lang === code ? 'active' : ''}`}
        aria-label={label}
        hreflang={code}
        lang={code}
        aria-current={lang === code ? 'true' : undefined}
        data-lang={code}
        onclick="sessionStorage.setItem('scrollPosition', window.scrollY.toString())"
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</nav>

<script>
  import { defaultLang, languages } from '../../../i18n/ui';

  document.addEventListener('astro:page-load', () => {
    // Determine current language from URL
    let [, currentLang] = window.location.pathname.split('/');
    if (!currentLang || !(currentLang in languages)) {
      currentLang = defaultLang;
    }
    
    const buttons = document.querySelectorAll('.lang-btn');
    buttons.forEach(btn => {
      // Re-evaluate href to keep it correct if we navigated
      const code = btn.getAttribute('data-lang');
      if (code) {
        let newPath = window.location.pathname.replace(`/${currentLang}`, '');
        if (newPath === '') newPath = '/';
        btn.setAttribute('href', `/${code}${newPath === '/' ? '' : newPath}`);
        
        const isCurrent = code === currentLang;
        btn.classList.toggle('active', isCurrent);
        if (isCurrent) btn.setAttribute('aria-current', 'true');
        else btn.removeAttribute('aria-current');
      }
    });
  });
</script>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.15rem;
    align-items: center;
    padding: 0.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border-light);
  }

  .lang-btn {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.5rem;
    border-radius: calc(var(--radius) - 1px);
    color: var(--text-secondary);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .lang-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }

  .lang-btn.active {
    background-color: var(--accent);
    color: var(--on-accent);
  }
</style>


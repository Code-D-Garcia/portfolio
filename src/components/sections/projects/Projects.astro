---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import ImageModal from '../../ui/image-modal/ImageModal.astro';
import { projectFilters } from '../../../data/project-filters';
import { toLang, useTranslations } from '../../../i18n/ui';

interface Props {
	limit?: number;
	showAllLink?: boolean;
	showFilters?: boolean;
}

const { limit, showAllLink = false, showFilters = false } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = limit ? allProjects.slice(0, limit) : allProjects;

const usedTech = new Set(allProjects.flatMap((p) => p.data.stack));
const filters = projectFilters.filter((tech) => usedTech.has(tech));
---

<section id="projects" class="projects-section">
	<h2 class="section-title">
		{showFilters ? t('projects.all.title') : t('projects.title')}
	</h2>

	{showFilters && <ProjectFilters filters={filters} />}

	<div class="projects-grid">
		{projects.map((project) => <ProjectCard project={project.data} />)}
	</div>

	{showAllLink && (
		<div class="show-all-wrapper">
			<a href={getRelativeLocaleUrl(lang, 'other/projects/')} class="show-all-btn">
				{t('projects.more')}
			</a>
		</div>
	)}
</section>

<ImageModal />

<style>
	.projects-section {
		display: flex;
		flex-direction: column;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 640px) {
		.projects-grid {
			grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		}
	}

	.show-all-wrapper {
		display: flex;
		justify-content: center;
		margin-top: 3rem;
	}

	.show-all-btn {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--bg-primary);
		background-color: var(--text-primary);
		padding: 0.75rem 2rem;
		border-radius: 30px;
		border: 1px solid transparent;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.show-all-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
		filter: brightness(1.1);
	}

	.show-all-btn:active {
		transform: translateY(0);
	}
</style>

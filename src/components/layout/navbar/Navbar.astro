---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { toLang, useTranslations } from '../../../i18n/ui';
import LanguageSwitcher from '../../ui/language-switcher/LanguageSwitcher.astro';
import ThemeToggle from '../../ui/theme-toggle/ThemeToggle.astro';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang);
const isHome = Astro.url.pathname === `/${lang}` || Astro.url.pathname === `/${lang}/`;
const homePrefix = isHome ? "" : `/${lang}/`;
---
<!--
	Desktop: floating pill with links, language and theme.
	Mobile (≤900px): full-width bar (name, theme, menu button) with a drop-down panel.
-->
<nav class="navbar" id="navbar" aria-label={t('a11y.nav.main')}>
	<div class="navbar-header">
		<a href={homeUrl} class="brand">David Garcia</a>
		<div class="header-actions">
			<ThemeToggle />
			<button
				type="button"
				id="menu-toggle"
				class="menu-toggle"
				aria-label={t('a11y.menu.open')}
				aria-expanded="false"
				aria-controls="nav-content"
				data-label-open={t('a11y.menu.open')}
				data-label-close={t('a11y.menu.close')}
			>
				<svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
				</svg>
			</button>
		</div>
	</div>
	<div class="nav-content" id="nav-content">
		<ul class="nav-list">
			<li><a href={`${homePrefix}#profile`} class="nav-link">{t('nav.profile')}</a></li>
			<li><a href={`${homePrefix}#stack`} class="nav-link">{t('nav.stack')}</a></li>
			<li><a href={`${homePrefix}#experience`} class="nav-link">{t('nav.experience')}</a></li>
			<li><a href={`${homePrefix}#education`} class="nav-link">{t('nav.education')}</a></li>
			<li><a href={`${homePrefix}#projects`} class="nav-link">{t('nav.projects')}</a></li>
		</ul>
		<div class="nav-actions">
			<LanguageSwitcher />
			<div class="desktop-theme">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	// Listeners live on the document (registered once), because the navbar is
	// re-rendered on every client-side navigation.
	const getParts = () => ({
		navbar: document.getElementById('navbar'),
		toggle: document.getElementById('menu-toggle'),
		content: document.getElementById('nav-content'),
	});

	const isOpen = () => getParts().toggle?.getAttribute('aria-expanded') === 'true';

	function setOpen(open: boolean) {
		const { navbar, toggle, content } = getParts();
		if (!navbar || !toggle || !content) return;
		content.classList.toggle('active', open);
		navbar.classList.toggle('menu-open', open);
		toggle.setAttribute('aria-expanded', String(open));
		const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
		if (label) toggle.setAttribute('aria-label', label);
	}

	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		if (!target) return;

		if (target.closest('#menu-toggle')) {
			setOpen(!isOpen());
			return;
		}

		if (!isOpen()) return;
		// Close after choosing a section, or when tapping anywhere outside the navbar.
		const { navbar } = getParts();
		if (target.closest('.nav-link') || !navbar?.contains(target)) {
			setOpen(false);
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isOpen()) {
			setOpen(false);
			getParts().toggle?.focus();
		}
	});

	// Growing past the mobile breakpoint with the menu open would leave it stuck open.
	window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});
</script>

<style>
	.navbar {
		position: fixed;
		top: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1000;
		background-color: var(--nav-bg);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--border-light);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		display: flex;
		flex-direction: column;
		padding: 0.5rem 1rem;
		width: max-content;
		max-width: calc(100vw - 2rem);
	}

	.navbar-header {
		display: none;
	}

	.nav-content {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.nav-list {
		display: flex;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-secondary);
		padding: 0.5rem 1rem;
		border-radius: var(--radius);
		transition: color 0.2s ease, background-color 0.2s ease;
		text-decoration: none;
	}

	.nav-link:hover {
		color: var(--accent);
		background-color: var(--accent-soft);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 1rem;
		border-left: 1px solid var(--border-light);
	}

	.desktop-theme {
		display: flex;
	}

	@media (max-width: 900px) {
		/* Full-width bar pinned to the top with a solid background. */
		.navbar {
			top: 0;
			left: 0;
			right: 0;
			transform: none;
			width: 100%;
			max-width: none;
			padding: 0;
			border-width: 0 0 1px;
			border-radius: 0;
			box-shadow: none;
			background-color: var(--bg-secondary);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}

		.navbar.menu-open {
			box-shadow: var(--shadow);
		}

		.navbar-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			min-height: 3.5rem;
			padding: 0.375rem 0.75rem 0.375rem 1.25rem;
		}

		.brand {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			font-family: var(--font-display);
			font-size: 1.1rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			color: var(--text-primary);
			text-decoration: none;
		}

		.brand::before {
			content: '';
			width: 0.45rem;
			height: 0.45rem;
			border: 2px solid var(--accent);
			transform: rotate(45deg);
		}

		.header-actions {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}

		/* 44px touch targets for the bar buttons. */
		.header-actions :global(.theme-toggle),
		.menu-toggle {
			width: 2.75rem;
			height: 2.75rem;
		}

		.header-actions :global(.theme-toggle) {
			border-color: transparent;
		}

		.menu-toggle {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			background: transparent;
			border: 1px solid transparent;
			border-radius: var(--radius);
			color: var(--text-primary);
			cursor: pointer;
			transition: color 0.2s ease, border-color 0.2s ease;
		}

		.menu-toggle:hover,
		.menu-toggle[aria-expanded='true'] {
			color: var(--accent);
			border-color: var(--border-light);
		}

		.menu-toggle svg {
			width: 24px;
			height: 24px;
		}

		.icon-close,
		.menu-toggle[aria-expanded='true'] .icon-open {
			display: none;
		}

		.menu-toggle[aria-expanded='true'] .icon-close {
			display: block;
		}

		/* Drop-down panel under the bar. */
		.nav-content {
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem 0.75rem 1rem;
			border-top: 1px dashed var(--border-light);
		}

		.nav-content.active {
			display: flex;
		}

		.nav-list {
			flex-direction: column;
			gap: 0.125rem;
		}

		.nav-link {
			display: flex;
			align-items: center;
			min-height: 2.75rem;
			padding: 0.5rem 0.75rem;
			font-size: 1.05rem;
		}

		.nav-actions {
			margin-top: 0.5rem;
			padding: 1rem 0.75rem 0;
			border-left: none;
			border-top: 1px solid var(--border-light);
		}

		.nav-actions :global(.lang-btn) {
			padding: 0.6rem 1rem;
		}

		/* Theme lives in the bar on mobile. */
		.desktop-theme {
			display: none;
		}
	}
</style>

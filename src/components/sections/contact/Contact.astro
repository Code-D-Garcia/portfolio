---
import { socialLinks } from '../../../data/social';
import { toLang, useTranslations } from '../../../i18n/ui';

const t = useTranslations(toLang(Astro.currentLocale));
const email = socialLinks.find((social) => social.url.startsWith('mailto:'));
const linkedin = socialLinks.find((social) => social.name === 'LinkedIn');
---
<section id="contact" class="contact-section">
	<div class="contact-card panel">
		<p class="contact-kicker">{t('contact.kicker')}</p>
		<h2 class="contact-title">{t('contact.title')}</h2>
		<p class="contact-text">{t('contact.text')}</p>
		<div class="contact-actions">
			{email && (
				<a href={email.url} class="btn btn-primary">
					<span class="contact-icon" set:html={email.icon} aria-hidden="true" />
					{t('contact.email')}
				</a>
			)}
			{linkedin && (
				<a href={linkedin.url} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
					<span class="contact-icon" set:html={linkedin.icon} aria-hidden="true" />
					LinkedIn
				</a>
			)}
		</div>
	</div>
</section>

<style>
	.contact-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		padding: 2.5rem 1.5rem;
		text-align: center;
	}

	.contact-kicker {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.contact-title {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--text-primary);
		line-height: 1.2;
	}

	.contact-text {
		max-width: 32rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.contact-icon {
		display: inline-flex;
	}

	.contact-icon :global(svg) {
		width: 16px;
		height: 16px;
	}

	@media (min-width: 768px) {
		.contact-card {
			padding: 3rem 2rem;
		}

		.contact-title {
			font-size: 2rem;
		}
	}
</style>
